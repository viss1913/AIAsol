# ============================================
# DATABASE CONFIGURATION (MySQL)
# ============================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=bankfuture
DB_PORT=3306

# Alternative names (for Railway compatibility)
# MYSQLHOST=localhost
# MYSQLUSER=root
# MYSQLPASSWORD=your_mysql_password
# MYSQLDATABASE=bankfuture
# MYSQLPORT=3306

# ============================================
# ADMIN PANEL AUTHENTICATION
# ============================================
ADMIN_USER=admin
ADMIN_PASS=your_secure_password

# ============================================
# DEFAULT BOT (Optional)
# ============================================
# If set, a default bot will be created automatically on first run
# TELEGRAM_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# ============================================
# AI CONFIGURATION (OpenRouter)
# ============================================
OPENROUTER_API_KEY=your_openrouter_api_key
# Slug модели OpenRouter, см. https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-2.5-flash
# Slug мультимодальной vision модели для фото/картинок
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# ============================================
# IMAGE GENERATION (OpenRouter modalities)
# ============================================
# Модель с output_modalities=image, см. https://openrouter.ai/models?output_modalities=image
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# image | image,text — зависит от модели
OPENROUTER_IMAGE_MODALITIES=image
# OPENROUTER_IMAGE_ASPECT_RATIO=1:1
# OPENROUTER_IMAGE_SIZE=1K
# Сколько последних реплик history отдавать мета-LLM для /correct_image_my
IMAGE_PROMPT_CONTEXT_MESSAGES=10
# Макс. размер data URL для sessions.last_generated_image (байты)
MAX_STORED_IMAGE_BYTES=14680064

# ============================================
# PARTNER API (Optional)
# ============================================
# API key for external partners to use /chat endpoint
# PARTNER_API_KEY=your_partner_api_key

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=development
