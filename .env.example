# ============================================
# DATABASE CONFIGURATION (MySQL)
# ============================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=bankfuture
DB_PORT=3306

# Alternative names (for Railway compatibility)
# MYSQLHOST=localhost
# MYSQLUSER=root
# MYSQLPASSWORD=your_mysql_password
# MYSQLDATABASE=bankfuture
# MYSQLPORT=3306

# ============================================
# ADMIN PANEL AUTHENTICATION
# ============================================
ADMIN_USER=admin
ADMIN_PASS=your_secure_password

# ============================================
# DEFAULT BOT (Optional)
# ============================================
# If set, a default bot will be created automatically on first run
# TELEGRAM_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# ============================================
# AI CONFIGURATION (OpenRouter)
# ============================================
OPENROUTER_API_KEY=your_openrouter_api_key
# Slug модели OpenRouter, см. https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-2.5-flash
# Slug мультимодальной vision модели для фото/картинок
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# ============================================
# IMAGE GENERATION (OpenRouter modalities)
# ============================================
# Модель с output_modalities=image, см. https://openrouter.ai/models?output_modalities=image
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# Fallback если основная image-модель вернула 429/no_image (напр. gpt-5.4-image)
OPENROUTER_IMAGE_MODEL_FALLBACK=google/gemini-2.5-flash-image
# Для Gemini image: image,text (дефолт в коде, если не задано)
OPENROUTER_IMAGE_MODALITIES=image,text
# OPENROUTER_IMAGE_ASPECT_RATIO=1:1
# OPENROUTER_IMAGE_SIZE=1K
# Сколько последних реплик history отдавать мета-LLM для /correct_image_my
IMAGE_PROMPT_CONTEXT_MESSAGES=10
# Макс. размер data URL для sessions.last_generated_image (байты)
MAX_STORED_IMAGE_BYTES=14680064
# WebP-сжатие: качество и макс. сторона в px
IMAGE_WEBP_QUALITY=82
IMAGE_MAX_EDGE_PX=1536
# Лимит бинарного размера референса перед отправкой в OpenRouter
IMAGE_MAX_REFERENCE_BYTES=786432
# Сколько минут хранить last_generated_image для /correct_image_your
LAST_GENERATED_IMAGE_TTL_MINUTES=10
# Сколько минут хранить last_user_image (фото пользователя из прошлого сообщения)
LAST_USER_IMAGE_TTL_MINUTES=30
# Перекинуть create_image -> correct_image_your если похоже на правку свежей bot-картинки
IMAGE_EDIT_REROUTE=1
# Ключевые слова (через запятую) для референса на прошлое фото пользователя
# IMAGE_REFERENCE_KEYWORDS=этот,график,вставь,на экран
# Ключевые слова для эвристики «правка последней картинки бота»
# IMAGE_EDIT_KEYWORDS=измени,замени,телепуз,сделай
# Ключевые слова для новой генерации (fallback correct_your → create_image)
# IMAGE_GENERATE_KEYWORDS=сгенер,нарисуй,создай
# Ключевые слова для вопросов об изображении (vision, не image edit)
# IMAGE_ANALYSIS_KEYWORDS=позе,опиши,проанализируй,что на фото
# Команды, где разрешён fallback на глобальный image_vision (анализ еды)
VISION_COMMANDS=/ocr,/ccal
# DEBUG_IMAGE_GEN=1

# ============================================
# PARTNER API (Optional)
# ============================================
# API key for external partners to use /chat endpoint
# PARTNER_API_KEY=your_partner_api_key

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=development
